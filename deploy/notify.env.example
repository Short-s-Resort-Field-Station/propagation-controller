# Phone notifications for Propagation Unit 01 — reservoir lockouts only.
# Installed by install.sh to /etc/propagation-controller/notify.env (root, 0600)
# and loaded by systemd; propagationd reads nothing else for this. Leave a
# transport's lines blank to disable it. Restart propagationd after editing:
#   sudo systemctl restart propagationd
#
# What gets sent: "Reservoir empty" (pump locked out below the cutoff),
# "Reservoir sensor offline", and the matching "refilled" / "sensor back"
# follow-ups. Nothing else.

PROPAGATION_UNIT_NAME=Propagation Unit 01

# --- ntfy push (no account; install the ntfy app and subscribe to the topic) ---
# Pick a topic nobody can guess: pu01- followed by 16 random hex characters.
#   openssl rand -hex 8
PROPAGATION_NTFY_SERVER=https://ntfy.sh
PROPAGATION_NTFY_TOPIC=

# --- Twilio SMS (needs your own Twilio account; E.164 numbers, +1...) ---
PROPAGATION_TWILIO_ACCOUNT_SID=
PROPAGATION_TWILIO_AUTH_TOKEN=
PROPAGATION_TWILIO_FROM=
PROPAGATION_TWILIO_TO=
